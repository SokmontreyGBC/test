@page
@model PhoneModel
@{
    ViewData["Title"] = "Manage Phone Number";
    ViewData["ActivePage"] = ManageNavPages.Phone; // Using existing property to avoid errors
    ViewData["Page"] = "Account";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="bg-white border card p-4">
    <form id="phone-form" method="post">
        <div asp-validation-summary="All" class="text-danger font-monospace small" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Input.NewPhoneNumber" class="form-label font-monospace">New Phone Number</label>
            <input asp-for="Input.NewPhoneNumber" class="form-control font-monospace" value="@Model.PhoneNumber" />
            <span asp-validation-for="Input.NewPhoneNumber" class="text-danger font-monospace small"></span>
        </div>

        <div class="d-flex justify-content-end mt-5">
            <button id="update-phone-button" type="submit"
                    class="btn btn-outline-dark font-monospace">
                Update phone number
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}