@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    ViewData["Page"] = "Account";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="bg-white border card p-4">
    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger font-monospace small" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Input.OldPassword" class="form-label font-monospace">Current Password</label>
            <input asp-for="Input.OldPassword" class="form-control font-monospace"
                   autocomplete="current-password" aria-required="true"
                   placeholder="Please enter your current password." />
            <span asp-validation-for="Input.OldPassword" class="text-danger font-monospace small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.NewPassword" class="form-label font-monospace">New Password</label>
            <input asp-for="Input.NewPassword" class="form-control font-monospace"
                   autocomplete="new-password" aria-required="true"
                   placeholder="Please enter your new password." />
            <span asp-validation-for="Input.NewPassword" class="text-danger font-monospace small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="form-label font-monospace">Confirm New Password</label>
            <input asp-for="Input.ConfirmPassword" class="form-control font-monospace"
                   autocomplete="new-password" aria-required="true"
                   placeholder="Please confirm your new password." />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger font-monospace small"></span>
        </div>

        <div class="d-flex justify-content-end mt-5">
            <button type="submit" class="btn btn-outline-dark font-monospace">
                Update password
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}