@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["Page"] = "Account";
}

<div class="container-fluid p-0">
    <div class="row g-0">
        <div class="col-12">
            <div class="px-4 py-2 bg-light border-bottom">
                <h3 class="fw-bold font-monospace text-start">@ViewData["Title"]</h3>
            </div>
        </div>
    </div>

    <div class="row g-0 mt-4">  
        <div class="col-md-9">
            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="bg-white border card p-4">
                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger font-monospace small" role="alert"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Username" class="form-label font-monospace">Username</label>
                        <input asp-for="Username" class="form-control font-monospace" placeholder="Please choose your username." disabled />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.PhoneNumber" class="form-label font-monospace">Phone Number</label>
                        <input asp-for="Input.PhoneNumber" class="form-control font-monospace" placeholder="Please enter your phone number."/>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="d-flex justify-content-end mt-5">
                        <button id="update-profile-button" type="submit" class="btn btn-outline-dark font-monospace">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}