@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    ViewData["Page"] = "Account";
}

<div class="container-fluid p-0">
    <div class="row g-0 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 p-4">
            <h3 class="fw-bold font-monospace text-start">@ViewData["Title"]</h3>
            <div class="bg-white border card p-4">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger font-monospace small" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label font-monospace">Email</label>
                        <input asp-for="Input.Email" class="form-control font-monospace" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label font-monospace">Password</label>
                        <input asp-for="Input.Password" class="form-control font-monospace" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <span asp-validation-for="Input.Password" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label font-monospace" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <button id="login-submit" type="submit" class="btn btn-outline-dark font-monospace w-100">
                            Log in
                        </button>
                    </div>

                    <div class="mt-4 font-monospace">
                        <div class="d-flex flex-column gap-2">
                            <a id="forgot-password" class="text-decoration-none text-dark" asp-page="./ForgotPassword">
                                Forgot your password?
                            </a>
                            <a class="text-decoration-none text-dark" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                                Register as a new user
                            </a>
                            <a id="resend-confirmation" class="text-decoration-none text-dark" asp-page="./ResendEmailConfirmation">
                                Resend email confirmation
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}