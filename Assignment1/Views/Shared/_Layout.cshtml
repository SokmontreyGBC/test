@*         &copy; 2025 - Assignment1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
@*     </div> *@
@* </footer> *@


@await RenderSectionAsync("Scripts", required: false)
</body>
</html>