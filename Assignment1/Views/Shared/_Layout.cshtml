<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Assignment1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Assignment1.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
</head>

<body>
<div class="d-flex flex-row vh-100">
    <div class="sidebar-width border-end d-flex">
        <header class="p-4 align-self-stretch d-flex flex-column">
            <p class="font-monospace ">
                 Assignment1
            </p>
            <nav class="flex-grow-1 d-flex flex-column">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link @( (string)ViewData["Page"]! == "Home" ? "text-primary" : "text-dark") "
                           asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @( (string)ViewData["Page"]! == "Products" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @( (string)ViewData["Page"]! == "Inventory" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Inventory" asp-action="Index">Inventory</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @( (string)ViewData["Page"]! == "Categories" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Categories" asp-action="Index">Categories</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a href="" class="nav-link"
                           >Sign in</a>
                    </li>
                    <li class="nav-item">
                        <a href="" class="nav-link"
                        >About us</a>
                    </li>
                </ul>
            </nav>
        </header>
    </div>
    <div class="flex-grow-1 overflow-scroll">
        <main role="main" class="p-4 ">
            @RenderBody()
        </main>
    </div>
</div>

@* <footer class="border-top footer text-muted"> *@
@*     <div class="container"> *@
@*         &copy; 2025 - Assignment1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
@*     </div> *@
@* </footer> *@


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>