
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Assignment1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Assignment1.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>

<body>
<div class="d-flex flex-row vh-100">
    <div class="sidebar-width border-end d-flex">
        <header class="p-4 align-self-stretch d-flex flex-column">
            <p class="font-monospace ">
                 Brother's Oats
            </p>
            <nav class="flex-grow-1 d-flex flex-column">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link @( (string)ViewData["Page"]! == "Home" ? "text-primary" : "text-dark") "
                           asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @( (string)ViewData["Page"]! == "Products" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Client" asp-action="Index">Products</a>
                    </li>
                    @if (@SignInManager.IsSignedIn(User)){

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Logout">
                            <i class="nav-link @((string)ViewData["Page"]! == "Admin" ? "text-primary" : "text-dark")"></i>
                            Logout</a>
                    </li>
                    
                    }else{
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">
                            <i class="nav-link @((string)ViewData["Page"]! == "Admin" ? "text-primary" : "text-dark")"></i>
                            Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">
                            <i class="nav-link @((string)ViewData["Page"]! == "Admin" ? "text-primary" : "text-dark")"></i>
                            Register</a>
                    </li>
                    }
                </ul>
                <ul class="navbar-nav flex-grow">
                    <li class="nav-item">
                        <a class="nav-link @((string)ViewData["Page"]! == "Admin" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Admin" asp-action="Index">
                            Admin
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((string)ViewData["Page"]! == "Categories" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Categories" asp-action="Index">
                            Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((string)ViewData["Page"]! == "Order History" ? "text-primary" : "text-dark")"
                           asp-area="" asp-controller="Order" asp-action="AllOrders">
                            Order History
                        </a>
                    </li>
                    
                </ul>
                @* <ul class="navbar-nav"> *@
                @*     $1$ <li class="nav-item"> #1# *@
                @*     $1$     <a href="" class="nav-link" #1# *@
                @*     $1$        >Sign in</a> #1# *@
                @*     $1$ </li> #1# *@
                @*     <li class="nav-item"> *@
                @*         <a class="nav-link @( (string)ViewData["Page"]! == "About Us" ? "text-primary" : "text-dark")" *@
                @*             asp-area="" asp-controller="Home" asp-action="AboutUs"> *@
                @*             About us *@
                @*         </a> *@
                @*     </li> *@
                @* </ul> *@
            </nav>
        </header>
    </div>
    <div class="flex-grow-1 overflow-scroll">
        <main role="main" class="p-4 ">
            @RenderBody()
        </main>
    </div>
</div>

@* <footer class="border-top footer text-muted"> *@
@*     <div class="container"> *@
@*         &copy; 2025 - Assignment1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
@*     </div> *@
@* </footer> *@


@await RenderSectionAsync("Scripts", required: false)
</body>
</html>