}

<div class="container-fluid p-0">
    <div class="row g-0">
        <div class="col-12">
            <div class="px-4 py-5 bg-light border-bottom">
                <h1 class="display-4 fw-bold font-monospace text-start">Order History</h1>
                <p class="lead mb-4 font-monospace text-start">View previous orders</p>
            </div>
        </div>
    </div>

    <div class="row g-0 mt-4">
        <div class="col-12 p-4">
            <div class="bg-white border p-4">
                <div class="row g-4 mb-4">


                    <div class="table-responsive">
                        <table class="table table-borderless font-monospace">
                            <thead class="border-bottom">
                            <tr>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody class="tableData" id="product-rows-container">
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="m-0 font-monospace">Order ID: @order.OrderId</h5>
                                                <p class="m-0 font-monospace">Order Date: @order.OrderDate</p>
                                                <p class="m-0 font-monospace">Total Price: $@order.TotalPrice</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>