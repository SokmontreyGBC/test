@model List<OrderItem>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";

    var cost = Model.Sum(items =>
        items.Product!.ProductPrice * items.Quantity);
}

<div class="d-flex flex-column gap-4">
    <div class="flex-grow-1 bg-white border p-4 card">
        <h3 class="font-monospace">Order Summary</h3>
        <br>
        @foreach (var items in Model)
        {
            <div class="card mb-3 border ">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="font-monospace">@items.Product!.ProductName</h5>
                            <p class="small mb-0 font-monospace text-muted">@items.Product.ProductDescription</p>
                        </div>
                        <div class="text-end">
                            <h6 class="fw-normal mb-0 font-monospace">@items.Quantity x</h6>
                            <h6 class="mb-0 font-monospace">$@items.Product.ProductPrice</h6>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end">
            <h5 class="fw-bold font-monospace">Total Cost: $@cost</h5>
        </div>
    </div>

    <div class="flex-grow-1 bg-white border p-4 card">
        <h3 class="font-monospace">Account</h3>
        <br>

        <div class="d-flex flex-column gap-2">
            @if (ViewBag.User != null)
            {
                <div class="card mb-3 border">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h5 class="font-monospace">User Information</h5>
                                <p class="small mb-0 font-monospace">Email: @ViewBag.User.Identity?.Name</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <form class="d-flex flex-row gap-2 mt-4"
              asp-controller="Order"
              asp-action="CheckoutConfirm"
              method="post">
            <a asp-controller="Client"
               asp-action="Index"
               class="btn btn-outline-dark w-100 font-monospace">
                Go Back
            </a>
            <button type="submit" class="btn btn-dark font-monospace w-100">
                Place Order
            </button>
        </form>
    </div>
</div>


@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
