@model ApplicationUser
@{
    ViewBag.Title = "Checkout";
    Layout = "_Layout";

    decimal cost = 0;
    foreach (var items in ViewBag.OrderItems)
        cost += items.Product.ProductPrice * items.Quantity;

    var isLoggedIn = User.Identity.IsAuthenticated;

    // Get the current user's details safely
    string userName = User.Identity.IsAuthenticated ? User.Identity.Name : null;
    string userEmail = Model?.Email;
    string userPhone = Model?.PhoneNumber;
}
<div class="d-flex flex-row gap-4">
    <div class="flex-grow-1 bg-white border p-4 card">
        <h3 class="font-monospace">Order Summary</h3>
        <br>
        @foreach (var items in ViewBag.OrderItems)
        {
            <div class="card mb-3 border ">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="font-monospace">@items.Product.ProductName</h5>
                            <p class="small mb-0 font-monospace text-muted">@items.Product.ProductDescription</p>
                        </div>
                        <div class="text-end">
                            <h6 class="fw-normal mb-0 font-monospace">@items.Quantity x</h6>
                            <h6 class="mb-0 font-monospace">$@items.Product.ProductPrice</h6>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end">
            <h5 class="fw-bold font-monospace">Total Cost: $@cost</h5>
        </div>
    </div>

    <div class="flex-grow-1 bg-white border p-4 card">
        <h3 class="font-monospace">@(isLoggedIn ? "Checkout" : "Guest Checkout")</h3>

        <form asp-controller="Order" asp-action="CheckoutOrder" method="post">
            @if (isLoggedIn)
            {
                <div class="card mb-4 border bg-light">
                    <div class="card-body">
                        <h5 class="font-monospace mb-3">Your Information</h5>

                        <div class="mb-2">
                            <span class="fw-bold font-monospace">Email:</span>
                            <span class="font-monospace">@userName</span>
                            <input type="hidden" name="UserName" value="@userName" />
                        </div>

                        @if (!string.IsNullOrEmpty(userEmail))
                        {
                            <div class="mb-2">
                                <span class="fw-bold font-monospace">Email:</span>
                                <span class="font-monospace">@userEmail</span>
                                <input type="hidden" name="Email" value="@userEmail" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(userPhone))
                        {
                            <div class="mb-2">
                                <span class="fw-bold font-monospace">Phone:</span>
                                <span class="font-monospace">@userPhone</span>
                                <input type="hidden" name="PhoneNumber" value="@userPhone" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label for="PhoneNumber" class="form-label font-monospace">Phone Number (Optional)</label>
                                <input name="PhoneNumber" id="PhoneNumber" class="form-control font-monospace" />
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label for="UserName" class="form-label font-monospace">Name</label>
                    <input name="UserName" id="UserName" class="form-control font-monospace" required />
                    <span class="text-danger font-monospace small field-validation-valid" data-valmsg-for="UserName"></span>
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label font-monospace">Email</label>
                    <input type="email" name="Email" id="Email" class="form-control font-monospace" required />
                </div>
                <div class="mb-3">
                    <label for="PhoneNumber" class="form-label font-monospace">Phone Number (Optional)</label>
                    <input name="PhoneNumber" id="PhoneNumber" class="form-control font-monospace" />
                </div>
            }

            <div class="mb-4">
                <label for="ShippingAddress" class="form-label font-monospace">Shipping Address</label>
                <textarea name="ShippingAddress" id="ShippingAddress" class="form-control font-monospace" rows="3" required></textarea>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Client" asp-action="Index" class="btn btn-outline-dark w-50 font-monospace">Go Back</a>
                <button type="submit" class="btn btn-dark w-50 font-monospace">Place Order</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}