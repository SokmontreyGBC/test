@using Microsoft.AspNetCore.Http.Features
@model User

@{
    ViewBag.Title = "Order Confirmation";
    Layout = "_Layout";
    decimal cost = 0;
    foreach (var items in ViewBag.OrderItems)
        cost += items.Product.ProductPrice * items.Quantity;
    
}

<div class="container mt-5 mb-5">
        <div class="row d-flex justify-content-center">
            <div class="col-md-8">
                <div class="card">
                        <div class="invoice p-5">
                            <h5>Your order Confirmed!</h5>

                            <h4 class="font-weight-bold d-block mt-4"> Thanks @TempData["Name"] !</h4>
                            <span>Your order has been confirmed and will be shipped soon!</span>

                            <div class="payment border-top mt-3 mb-3 border-bottom table-responsive">
                                <table class="table table-borderless">
                                    
                                    <tbody>
                                        <tr>
                                            <td>
                                                <div class="py-2">

                                                    <span class="d-block text-muted">Order Date</span>
                                                    
                                                </div>
                                            </td>

                                            <td>
                                                <div class="py-2">

                                                    <span class="d-block text-muted">Order No</span>
                                                <span>To be inserted later</span>
                                                    
                                                </div>
                                            </td>

                                            <td>
                                            </td>

                                            <td>
                                                <div class="py-2">

                                                    <span class="d-block text-muted">Shipping Address</span>
                                                <span>Generic 123 Street, K1K 1K1</span>
                                                    
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>

                                </table>
                                
                            </div>

                                <div class="product border-bottom table-responsive">

                                    <table class="table table-borderless">
                                    @foreach (var item in ViewBag.OrderItems)
                                    {
                                        <tbody>
                                        <tr>

                                            <td width="60%">
                                                <span class="font-weight-bold font-size-4 h5">@item.Product.ProductName</span>
                                                <div class="product-qty">
                                                    <span class="d-block">@item.Product.ProductDescription</span>
                                                    <span>Quantity:@item.Quantity</span>

                                                </div>
                                            </td>
                                            <td width="20%">
                                                <div class="text-right">
                                                    <span class="font-weight-bold">$@item.Product.ProductPrice</span>
                                                </div>
                                            </td>
                                        </tr>

                                        </tbody>
                                    }
                                    </table>
                                    
                                </div>
                            
                                <div class="row d-flex justify-content-end">
                                    <div class="col-md-5">
                                        <table class="table table-borderless">
                                            <tbody class="totals">
                                                <tr>
                                                    <td>
                                                        <div class="text-left">
                                                            <span class="text-muted">Total</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="text-right">
                                                            <span>$@cost</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            
                                            
                                            </tbody>
                                            
                                        </table>
                                        
                                    </div>
                                    


                                </div>


                            <span>We will be sending shipping confirmation email when the item shipped successfully!</span>
                           
                            <a asp-action="Index" asp-controller="Home" class="btn btn-primary"> Back to Home</a>
                            
                        </div>
                        
        </div>
                
            </div>
            
        </div>
        
    </div>