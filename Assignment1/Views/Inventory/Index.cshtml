@model List<Product>
@{
    ViewData["Page"] = "Inventory";
    ViewBag.Title = "Inventory";
    Layout = "_Layout";
    var cart = ViewBag.Cart as List<Product>;
}
<div class="row align-items-start">
    <h2 class="col-auto">Client-Facing Inventory</h2>
    <div class="col-auto ms-auto">
        @* Align cart button to the right *@
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
            <i class="fa-solid fa-cart-shopping"></i>
        </button>
    </div>
</div>

<br/>
@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Stock</th>
            <th></th>
        </tr>
        </thead>

        <tbody class="tableData">
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.ProductDescription</td>
                <td>@product.ProductPrice</td>
                <td>@product.Category.CategoryName</td>
                <td>@product.ProductStock</td> @*THIS NEEDS TO BE CHANGED TO REFLECT STOCK QUANTITY*@
                <td>
                    <form asp-action="AddToCart" asp-controller="Inventory" method="post">
                        <input type="hidden" name="id" value="@product.ProductId"/>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }

        </tbody>
    </table>
}
else
{
    <br/>
    <p>No products found.</p>
}
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasExampleLabel">Cart</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        @if (cart != null && cart.Any())
        {
            <ul class="list-group">
                @foreach (var item in cart)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@item.ProductName - @item.ProductPrice</span>
                        <form asp-action="RemoveFromCart" asp-controller="Inventory" method="post">
                            <input type="hidden" name="id" value="@item.ProductId"/>
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Your cart is empty.</p>
        }
    </div>
    <div class="offcanvas-end d-flex justify-content-end m-4">
        <a asp-action="CheckoutOrder" class="btn btn-primary">Checkout</a>
    </div>
</div>

@* AJAX to stop refresh issue on remove *@
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ALL THE BUTTONS THIS TIME
            const removeButtons = document.querySelectorAll('.list-group-item button');
            removeButtons.forEach(button => {
                button.addEventListener('click', async function(e) {
                    e.preventDefault();
                    
                    // this.id
                    const form = button.closest('form');
                    const productId = form.querySelector('input[name="id"]').value;
                    
                    // vile async trickery ensues
                    try {
                        const response = await fetch(`/Inventory/RemoveFromCart/${productId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });
                        if (response.ok) {
                            // Remove the item
                            const listItem = button.closest('.list-group-item');
                            listItem.remove();

                            // If cart is empty
                            const cartItems = document.querySelectorAll('.list-group-item');
                            if (cartItems.length === 0) {
                                const cartBody = document.querySelector('.offcanvas-body');
                                cartBody.innerHTML = '<p>Your cart is empty.</p>';
                            }
                        }
                    } catch (error) {
                        console.error('Error removing item:', error);
                    }
                });
            });
        });
    </script>
}