@{
    ViewData["Title"] = "Home";
    ViewData["Page"] = "Home";
}

@model IEnumerable<Product>

<div class="container-fluid p-0">
    <div class="row g-0">
        <div class="col-12">
            <div class="px-4 py-5 text-center bg-light border-bottom">
                <h1 class="display-4 fw-bold font-monospace text-start">Assignment1</h1>
                <p class="lead mb-4 font-monospace text-start">A brutalist e-commerce solution for a brutal world</p>
            </div>
        </div>
    </div>

    <div class="row g-0 mt-4">
        <div class="col-md-6 p-4">
            <div class="h-100 p-4 bg-white border">
                <h2 class="font-monospace mb-4">Hot Products!</h2>
                <div class="list-group">
                    @foreach (var product in Model.OrderByDescending(p => p.ProductStock).Take(3))
                    {
                        <div class="list-group-item border-0 font-monospace">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@product.ProductName</h6>
                                    <small class="text-muted">Stock: @product.ProductStock</small>
                                </div>
                                <span class="text-muted">$@product.ProductPrice.ToString("F2")</span>
                            </div>
                        </div>
                    }
                </div>
                <a class="btn btn-outline-dark font-monospace mt-3" asp-controller="Client" asp-action="Index">
                    View All Products
                </a>
            </div>
        </div>

        <div class="col-md-6 p-4">
            <div class="h-100 p-4 bg-white border">
                <h2 class="font-monospace mb-4">Categories</h2>
                <p class="font-monospace">
                    Explore our product categories to find exactly what you need.
                </p>
                <a class="btn btn-outline-dark font-monospace mt-3" asp-controller="Categories" asp-action="Index">
                    Browse Categories
                </a>
            </div>
        </div>
    </div>

    <div class="row g-0">
        <div class="col-12 p-4">
            <div class="p-4 bg-white border">
                <h2 class="font-monospace mb-4">About Us</h2>
                <p class="font-monospace">
                    Learn more about our company and mission.
                </p>
                <a class="btn btn-outline-dark font-monospace mt-3" asp-controller="Home" asp-action="AboutUs">
                    Read More
                </a>
            </div>
        </div>
    </div>
</div>