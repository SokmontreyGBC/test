@using Assignment1.Controllers
@model List<Product>
@{
    ViewData["Page"] = "Products";
    ViewBag.Title = "Products";
    Layout = "_Layout";
}

<div class="row align-items-start">
    <h2 class="col-auto">Client-Facing Inventory</h2>
    <div class="col-auto ms-auto">
        @* Align cart button to the right *@
        <button class="btn btn-primary" type="button"
                onclick="getCart()"
                data-bs-toggle="offcanvas"
                data-bs-target="#offcanvasExample"
                aria-controls="offcanvasExample">
            <i class="fa-solid fa-cart-shopping"></i>
        </button>
    </div>
</div>

<div class="offcanvas offcanvas-end" style="width: 40%;" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasExampleLabel">Cart</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body" id="cart-container">
    </div>
    
    <div class="offcanvas-end d-flex justify-content-end m-4">
        <a class="btn btn-primary"
           asp-action="CheckoutOrder"
           asp-controller="Order">
            Checkout
        </a>
    </div>
</div>

@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Stock</th>
            <th></th>
        </tr>
        </thead>

        <tbody class="tableData">
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.ProductDescription</td>
                <td>@product.ProductPrice</td>
                <td>@product.Category.CategoryName</td>
                <td>@product.ProductStock</td>
                <td>
                    <form class="add-to-cart-form">
                        <input type="hidden" name="id" value="@product.ProductId"/>
                        <input type="number" name="quantity" value="1" min="1" max="@product.ProductStock" style="width: 5rem;" />
                        <button type="submit" class="btn btn-primary">
                            +
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <br/>
    <p>No products found.</p>
}

<div class="toast-container position-fixed bottom-0 end-0 p-3 m-3  ">
    <div id="liveToast"
         class="toast align-items-center text-bg-primary border-0"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="msg-container">
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close">

            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const liveToastElement = $("#liveToast")
        const toastBootstrap = bootstrap.Toast.getOrCreateInstance(liveToastElement)
        function getCart() {
            $.ajax({
                url: `/Client/GetCart`,
                type: "GET",
                success: function (data) {
                    $("#cart-container").html(data);
                }
            });
        }

        $(".add-to-cart-form").submit(function (e) {
            e.preventDefault();
            const form = this;
            const productId = form.querySelector('input[name="id"]').value;
            const quantity = form.querySelector('input[name="quantity"]').value;
            $.ajax({
                url: `/Client/AddToCart?id=${productId}&quantity=${quantity}`,
                type: "GET",
                complete: function (data) {
                    const resp = JSON.parse(data.responseText);
                    $('#msg-container').html(resp.message);
                    if (resp.success) {
                        liveToastElement[0].classList.add('text-bg-success');
                        liveToastElement[0].classList.remove('text-bg-danger');
                    } else {
                        liveToastElement[0].classList.remove('text-bg-success');
                        liveToastElement[0].classList.add('text-bg-danger');
                    }
                    toastBootstrap.show();
                },
            });
        });
        
        function getCart() {
            $.ajax({
                url: `/Client/GetCart`,
                type: "GET",
                success: function (data) {
                    $("#cart-container").html(data);
                    updateTotalCart();
                }
            });
        }
        
        function updateTotalCart() {
            $.ajax({
                url: `/Client/GetTotalCart`,
                type: "GET",
                success: function (data) {
                    $(".offcanvas-bottom h4").text(`Total: ${data.totalCart}`);
                }
            });
        }
    </script>
}