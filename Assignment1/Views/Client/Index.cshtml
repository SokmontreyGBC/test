@model List<Product>
@{
    ViewData["Page"] = "Products";
    ViewBag.Title = "Products";
    Layout = "_Layout";
    string selectedCategoryString = ViewData["SelectedCategoryString"] as string ?? "";
}

<div class="row g-0">
    <div class="col-12">
        <div class="px-4 py-2 bg-light border-bottom">
            <h1 class="display-4 fw-bold font-monospace text-start">Products</h1>
            <p class="lead mb-4 font-monospace text-start">Find our latest item here</p>
        </div>
    </div>
</div>

<div class="d-flex align-items-center gap-4 pt-4">
    <div class="d-flex align-items-center gap-2">
        <i class="fas fa-search text-muted"></i>
        <div class="col-md-auto">
            <input type="text" id="search-input" class="form-control font-monospace" placeholder="Search products...">
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-down-wide-short text-muted"></i>
        <div class="d-flex gap-2">
            <select name="sort" class="form-select font-monospace" onchange="orderByColumn(this.value)">
                @foreach (var column in ViewData["OrderableColumns"] as List<string>)
                {
                    <option value="@column">@column</option>
                }
            </select>
            <button onclick="toggleOrderType()" class="btn btn-outline-dark">
                <i class="fa-solid fa-arrow-down" id="order-arrow-icon"></i>
            </button>
        </div>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <i class="fa-solid fa-filter text-muted"></i>
        @Html.Partial("_TagSelector", new
        {
            Id = "category-tag",
            Tags = ViewData["Categories"] as List<Category>
        })
    </div>

    <div class="flex-grow-1"></div>

    <div class="d-flex justify-content-end">
        <button class="btn btn-outline-dark font-monospace" type="button"
                onclick="getCart()"
                data-bs-toggle="offcanvas"
                data-bs-target="#offcanvasExample"
                aria-controls="offcanvasExample">
            <i class="fa-solid fa-cart-shopping"></i>
        </button>
    </div>
</div>

@* ============================== CART Offcavas ============================== *@

<div class="offcanvas offcanvas-end"
     style="width: 50%;" tabindex="-1"
     id="offcanvasExample"
     aria-labelledby="offcanvasExampleLabel">

    <div class="offcanvas-header bg-light border-bottom">
        <h5 class="offcanvas-title font-monospace" id="offcanvasExampleLabel">Shopping Cart</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body font-monospace" id="cart-container">
    </div>

    <div class="offcanvas-footer bg-light border-top p-3 d-flex justify-content-end">
        <a class="btn btn-dark font-monospace"
           asp-action="CheckoutOrder"
           asp-controller="Order">
            Checkout
        </a>
    </div>
</div>


<div class="table-responsive border mt-4 rounded-3">
    <table class="table table-borderless font-monospace">
        <thead class="border-bottom">
        <tr>
            @foreach (var column in ViewData["Columns"] as List<string>)
            {
                <th class="text-muted">@column</th>
            }
            <th></th>
        </tr>
        </thead>

        <tbody class="tableData" id="product-rows-container">
        @* @await Html.PartialAsync("_ProductRows", Model, ViewData) *@
        </tbody>
    </table>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3 m-3">
    <div id="liveToast"
         class="toast align-items-center text-bg-primary border-0 font-monospace"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="msg-container">
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close">

            </button>
        </div>
    </div>
</div>


@section Scripts {
<script>
    let isDesc = false;
    let orderBy = "ID";
    let searchText = "";
    let selectedCategoriesString = "@selectedCategoryString";

    function orderByColumn(column) {
        orderBy = column;
        getProducts();
    }

    function toggleOrderType() {
        isDesc = !isDes; 
        $("#order-arrow-icon").attr("class", isDesc
            ? "fa-solid fa-arrow-up"
            : "fa-solid fa-arrow-down");
        getProducts();
    }

    function getProducts() {
        $.ajax({
            url: `/Product/GetProducts?orderType=${isDesc ? "desc" : "asc"}` +
                `&orderBy=${orderBy}` +
                `&searchString=${searchText}` +
                `&selectedCategoriesString=${selectedCategoriesString}` +
                `&isAdmin=${false}`,
            type: "GET",
            success: function (data) {
                $("#product-rows-container").html(data);
                $(".add-to-cart-form").submit(onAddToCart);
            }
        });
    }

    $("#search-input").on("keyup", function () {
        searchText = $(this).val();
        getProducts();
    });

    $(document).on('click', '.category-tag', function() {
        const selectedCategories = $("#selected-category-tag-container")
            .children()
            .toArray();

        selectedCategoriesString = selectedCategories.length
            ? selectedCategories
                .map(function(item) {
                    return item.name;
                })
                .join(",")
            : "";

        getProducts();
    });

    $(document).ready(function () {
        getProducts();
    });

    // ============================== Cart related ==============================

    const liveToastElement = $("#liveToast")
    const toastBootstrap = bootstrap.Toast.getOrCreateInstance(liveToastElement)

    const message = "@TempData["Message"]";
    const isSuccess = "@TempData["Success"]" === "True";

    if (message) {
        $("#msg-container").html(message);
        if (isSuccess) {
            liveToastElement[0].classList.add('text-bg-success');
            liveToastElement[0].classList.remove('text-bg-danger');
        } else {
            liveToastElement[0].classList.add('text-bg-danger');
            liveToastElement[0].classList.remove('text-bg-success');
        }
        toastBootstrap.show();
    }

    function onAddToCart(e) {
        e.preventDefault();
        const form = this;
        const productId = form.querySelector('input[name="id"]').value;
        const quantity = form.querySelector('input[name="quantity"]').value;

        $.ajax({
            url: `/Client/AddToCart?id=${productId}&quantity=${quantity}`,
            type: "GET",
            complete: function (data) {
                const resp = JSON.parse(data.responseText);
                $('#msg-container').html(resp.message);

                if (resp.success) {
                    liveToastElement[0].classList.add('text-bg-success');
                    liveToastElement[0].classList.remove('text-bg-danger');
                } else {
                    liveToastElement[0].classList.remove('text-bg-success');
                    liveToastElement[0].classList.add('text-bg-danger');
                }

                toastBootstrap.show();
            },
        });
    }

    function getCart() {
        $.ajax({
            url: `@Url.Action("GetCart", "Cart")`,
            type: "GET",
            success: function (data) {
                $("#cart-container").html(data);
            }
        });
    }
</script>
}