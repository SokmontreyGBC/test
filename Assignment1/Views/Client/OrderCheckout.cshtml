@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model List<OrderItem>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
    var cost = TempData["sum"] as string;
}

<h2>Order Summary Page</h2>
<br>

    @{
        foreach (var items in Model)
        {
            
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="d-flex flex-row align-items-center">
                            <div class="ms-3">
                                
                                @foreach (var product in ViewBag.Products)
                                    if (product.ProductId == items.ProductId)
                                    {
                                        <h5>@product.ProductName </h5>
                                        <p class="small mb-0">@product.ProductDescription</p>
                                    }
                            </div>
                                
                        </div>
                        <div class="d-flex flex-row align-items-center">
                            <div style="width: 50px;">
                                <h6 class="fw-normal mb-0">@items.Quantity x</h6>
                            </div>
                            <div style="width: 80px;">
                                @foreach (var product in ViewBag.Products)
                                    if (product.ProductId == items.ProductId)
                                    {
                                        <h6 class="mb-0">$@product.ProductPrice</h6>
                                    }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <br/>
        <div class="float-end">
            <h5> Total Cost: $@cost   </h5>
        </div>
        <br>
       
        
    }
    <div class="card p-4" style="margin-top: 10%;">
        <h3> Guest Checkout </h3>
        <form class="card-body" asp-action="CheckoutOrder" method="post">
            <div class="form-group">
                <label class="control-label">Name: </label>
                <input class="form-control"/>

                <label class="control-label">Email: </label>
                <input class="form-control"/>


            </div>
        </form>
    </div>
    <br></br>
    <a asp-action="CheckoutOrder" class="btn btn-primary">Order</a>