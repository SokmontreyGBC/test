@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model List<OrderItem>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Order Summary Page</h2>
<br>

    
    @{
        foreach (var items in Model)
        {
            
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="d-flex flex-row align-items-center">
                            <div class="ms-3">
                                <h5>ProductName: </h5>
                            </div>
                        </div>
                        <div class="d-flex flex-row align-items-center">
                            <div style="width: 50px;">
                                <h5 class="fw-normal mb-0">@items.Quantity x</h5>
                            </div>
                            <div style="width: 80px;">
                                <h5 class="mb-0">$$Product Cost</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="float-end">
            <h5> Total Cost :  ??? </h5>
        </div>
        <br>
       
        
        <div class="card p-4" style="margin-top: 10%;">
            <h3> Guest Checkout </h3>
            <form class="card-body" asp-action="CheckoutOrder" method="post">
                <div class="form-group">
                    <label class="control-label">Name: </label>
                    <input class="form-control"/>

                    <label class="control-label">Email: </label>
                    <input class="form-control"/>


                </div>
            </form>
        </div>
        <br></br>
        <a asp-action="CheckoutOrder" class="btn btn-primary">Order</a>
      
    }