@model Product

@{
    ViewBag.Title = "Add an Inventory Item";
    Layout = "_Layout";
    ViewData["Page"] = "Admin";
}

<div class="container-fluid p-0">
    <div class="row g-0 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 p-4">
            <h3 class="fw-bold font-monospace text-start">New Item</h3>
            <div class="bg-white border card p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-4">
                        <label asp-for="ProductName" class="form-label font-monospace">Product Name</label>
                        <input asp-for="ProductName" placeholder="Product Name" class="form-control font-monospace"/>
                        <span asp-validation-for="ProductName" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProductDescription" class="form-label font-monospace">Description</label>
                        <textarea asp-for="ProductDescription" class="form-control font-monospace" rows="3"></textarea>
                        <span asp-validation-for="ProductDescription" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProductPrice" class="form-label font-monospace">Price</label>
                        <div class="input-group">
                            <span class="input-group-text font-monospace">$</span>
                            <input asp-for="ProductPrice" min="0" placeholder="0.00" class="form-control font-monospace"/>
                        </div>
                        <span asp-validation-for="ProductPrice" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label font-monospace">Category</label>
                        <select asp-for="CategoryId" class="form-select font-monospace">
                            <option value="" disabled selected>Select a category...</option>
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProductStock" class="form-label font-monospace">Stock Quantity</label>
                        <input asp-for="ProductStock" placeholder="0" value="0" min="0" class="form-control font-monospace" type="number"/>
                        <span asp-validation-for="ProductStock" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <a class="btn btn-outline-secondary font-monospace"
                           asp-area=""
                           asp-controller="Admin"
                           asp-action="Index">
                            Back to Inventory
                        </a>
                        <button type="submit" class="btn btn-outline-dark font-monospace">
                            Create Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}