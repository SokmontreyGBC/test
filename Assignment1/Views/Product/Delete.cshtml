@model Product

@{
    ViewBag.Title = "Delete Product";
    Layout = "_Layout";
    ViewData["Page"] = "Admin";
}";

<div class="container-fluid p-0">
    <div class="row g-0">
        <div class="col-12">
            <div class="px-4 py-5 bg-light border-bottom">
                <h1 class="display-4 fw-bold font-monospace text-start">Delete Product</h1>
                <p class="lead mb-4 font-monospace text-start">Are you sure you want to delete this product?</p>
            </div>
        </div>
    </div>

    <div class="row g-0 justify-content-center mt-4">
        <div class="col-12 col-md-8 col-lg-6 p-4">
            <div class="bg-white border p-4">
                <dl class="row">
                    <dt class="col-sm-3 font-monospace">Product Name</dt>
                    <dd class="col-sm-9 font-monospace">@Html.DisplayFor(model => model.ProductName)</dd>

                    <dt class="col-sm-3 font-monospace">Description</dt>
                    <dd class="col-sm-9 font-monospace">@Html.DisplayFor(model => model.ProductDescription)</dd>
                </dl>

                <form
                    asp-controller="Product"
                    asp-action="Delete"
                    method="post"
                    class="mt-4">

                    @Html.HiddenFor(model => model.ProductId)
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index"
                           asp-controller="Admin"
                           asp-area=""
                           class="btn btn-outline-secondary font-monospace">Cancel</a>
                        <button type="submit" class="btn btn-danger font-monospace">Delete Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>