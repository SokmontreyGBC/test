@model List<Product>

@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th> 
            <th>
                <button
                    onclick="getProducts('#product-container', 'Name')"
                    class="btn btn-primary">
                    Name
                </button>
            </th>
            @* <th>Description</th> *@
        </tr>
        </thead>

        <tbody class="tableData">
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td> 
                @* <td>@product.ProductDescription</td> *@
                @* <td>@product.ProductPrice</td> *@
                @* <td>@product.Category.CategoryName</td> *@
                @* <td>@product.ProductStock</td> $1$THIS NEEDS TO BE CHANGED TO REFLECT STOCK QUANTITY#1# *@
                @* <td> *@
                @*     <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-warning">Delete</a> *@
                @*     <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-primary">Edit</a> *@
                @* </td> *@
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <br/>
    <p>No products found.</p>
}
