@model Product

@{
    ViewBag.Title = "Add an Inventory Item";
    Layout = "_Layout";
}
<div class="card p-4 w-50 mx-auto" style="margin-top: 10%;">
    <h2>Inventory Product Creation Form</h2>
    <br/>
    <form class="card-body" asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="ProductName" class="control-label"></label>
            <input asp-for="ProductName" class="form-control"/>
            <span asp-validation-for="ProductName" class="text-danger"></span>
            <label asp-for="ProductDescription" class="control-label"></label>
            <input asp-for="ProductDescription" class="form-control"/>
            <span asp-validation-for="ProductDescription" class="text-danger"></span>
            <label asp-for="ProductPrice" class="control-label">Price</label>
            <input asp-for="ProductPrice" class="form-control"/>
            <span asp-validation-for="ProductPrice" class="text-danger"></span>
            <label asp-for="CategoryId" class="control-label">Category</label>
            <select asp-for="CategoryId" class="form-select">
                @{
                    <option selected disabled hidden style="display: none; color: lightgrey" value="default">Choose an option...</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.CategoryId">@category.CategoryName</option>
                    }
                }
            </select>
            <label asp-for="StockId" class="control-label">Stock</label>
            <input asp-for="StockId" class="form-control"/>
            <span asp-validation-for="StockId" class="text-danger"></span>
        </div>
        <br/>
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-secondary" asp-action="Index">Back to Inventory</a>
            <button type="submit" class="btn btn-primary">Add Inventory Item</button>
        </div>


    </form>
    
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        
    }
}