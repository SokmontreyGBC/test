@model List<Product>
@{
    ViewData["Page"] = "Products";
    ViewBag.Title = "Products";
    Layout = "_Layout";
}
<div class="row align-items-start">
    <h2 class="col-auto">Current Inventory</h2>
    <div class="col-auto ms-auto">  @* Align cart button to the right *@
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
            <i class="fa-solid fa-cart-shopping"></i>
        </button>
    </div>
</div>

<div>
    <form asp-action="Index" method="get">
        <div class="form-actions no-color">
            <p>
                <label>Find by name: <input type="text" name="searchString" value=""/></label>
                <input type="submit" value="Search" class="btn btn-primary" />
                <a asp-action="Index">Back to Full List</a>
               
            </p>
        </div>
    </form>
</div>

<br/>
<div class="row">
    <div>
        <a class="btn btn-primary" asp-action="Create" asp-controller="Products">Add new Inventory Item</a>
    </div>
</div>

<br/>

<div class="d-inline-flex gap-2">
    <select name="sort" class="form-control" onchange="orderByColumn(this.value)">
        @foreach (var column in ViewData["OrderableColumns"] as List<string>)
        {
            <option value="@column">@column</option>
        }
    </select>
    <button onclick="toggleOrderType()" class="btn btn-primary">
        <i class="fa-solid fa-arrow-down" id="order-arrow-icon"></i>
    </button>
</div>

<table class="table">
    <thead>
    <tr>
        @foreach (var column in ViewData["Columns"] as List<string>)
        {
            <th> @column </th>
        }
        <th></th>
    </tr>
    </thead>

    <tbody class="tableData" id="product-rows-container">
    @await Html.PartialAsync("_ProductRows", Model)
    </tbody>
</table>

<script>
    let isDesc = true;
    let orderBy = "ID";

    function orderByColumn(column) {
        orderBy = column;
        getProducts();
    }

    function toggleOrderType() {
        isDesc = !isDesc;
        $("#order-arrow-icon").attr("class", isDesc
            ? "fa-solid fa-arrow-down"
            : "fa-solid fa-arrow-up");
        getProducts();
    }

    function getProducts() {
        $.ajax({
            url: `/Products/GetProducts?orderType=${isDesc ? "desc" : "asc"}&orderBy=${orderBy}`,
            type: "GET",
            success: function (data) {
                $("#product-rows-container").html(data);
            }
        });
    }

    $(document).ready(function () {
        getProducts();
    });
</script>
