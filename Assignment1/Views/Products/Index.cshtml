@model List<Product>
@{
    ViewBag.Title = "Products";
    Layout = "_Layout";
}

<h2>Current Inventory</h2>
<br/>
<div class="row">
    <div>
        <a class="btn btn-primary" asp-action="Create" asp-controller="Products">Add new Inventory Item</a>
    </div>
</div>
@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th> 
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Stock</th>
        </tr>
        </thead>

        <tbody class="tableData">
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td> 
                <td>@product.ProductDescription</td>
                <td>@product.ProductPrice</td>
                <td>@product.CategoryId</td>
                <td>@product.StockId</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <br/>
    <p>No products found.</p>
}