@model List<Product>
@{
    ViewData["Page"] = "Products";
    ViewBag.Title = "Products";
    Layout = "_Layout";
}
<div class="row align-items-start">
    <h2 class="col-auto">Current Inventory</h2>
    <div class="col-auto ms-auto">  @* Align cart button to the right *@
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
            <i class="fa-solid fa-cart-shopping"></i>
        </button>
    </div>
</div>

<div>
    <form asp-action="Index" method="get">
        <div class="form-actions no-color">
            <p>
                <label>Find by name: <input type="text" name="searchString" value=""/></label>
                <input type="submit" value="Search" class="btn btn-primary" />
                <a asp-action="Index">Back to Full List</a>
               
            </p>

        </div>

    </form>
</div>
<div>
    <form asp-action="Index" method="get">
        <div class="form-actions no-color">
        <select name="sort" class="form-control">
            <option value="default">Sort</option>
            <option value="@ViewData["priceSort"]">Price:High > Low</option>
            <option value="price_asc">Price:Low > High</option>
            <option value="name_asc">Name:A > Z</option>
            <option value="@ViewData["nameSort"]">Name:Z > A</option>
        </select>
        <input type="submit" value="Submit" class="btn btn-primary"/>
        </div>
    </form>
</div>

<br/>
<div class="row">
    <div>
        <a class="btn btn-primary" asp-action="Create" asp-controller="Products">Add new Inventory Item</a>
    </div>
</div>
@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th> 
        <th><a asp-action="Index" asp-route-sort="@ViewData["nameSort"]" class="text-dark">Name</a></th>
            <th>Description</th>
            <th><a asp-action="Index" asp-route-sort="@ViewData["priceSort"]" class="text-dark">Price</a></th>
            <th><a asp-action="Index" asp-route-sort="@ViewData["categorySort"]" class="text-dark">Category</a></th>
            <th><a asp-action="Index" asp-route-sort="@ViewData["stockSort"]" class="text-dark">Stock</a></th>
            <th> Actions </th>
        </tr>
        </thead>

        <tbody class="tableData">
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td> 
                <td>@product.ProductDescription</td>
                <td>@product.ProductPrice</td>
                <td>@product.Category.CategoryName</td>
                <td>@product.ProductStock</td> @*THIS NEEDS TO BE CHANGED TO REFLECT STOCK QUANTITY*@
                <td>
                    <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-warning">Delete</a>
                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-primary">Edit</a>
                </td>
            </tr>
        }
        
        </tbody>
    </table>
    
   
}
else
{
    <br/>
    <p>No products found.</p>
}
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasExampleLabel">Offcanvas</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <div>
      Some text as placeholder. In real life you can have the elements you have chosen. Like, text, images, lists, etc.
    </div>
    <div class="dropdown mt-3">
      <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        Dropdown button
      </button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="#">Action</a></li>
        <li><a class="dropdown-item" href="#">Another action</a></li>
        <li><a class="dropdown-item" href="#">Something else here</a></li>
      </ul>
    </div>
  </div>
</div>
