@model Product

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
<div class="card p-4 w-50 mx-auto" style="margin-top: 10%;">
    <form class="card-body" asp-action="Edit" method="post">
        @Html.HiddenFor(model => model.ProductId)
        <div class="form-group">
            <label asp-for="ProductName" class="control-label"></label>
            <input asp-for="ProductName" class="form-control">
            <span asp-validation-for="ProductName" class="text-bg-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ProductDescription" class="control-label"></label>
            <input asp-for="ProductDescription" class="form-control">
            <span asp-validation-for="ProductDescription" class="text-bg-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ProductPrice" class="control-label">Price</label>
            <input asp-for="ProductPrice" class="form-control">
            <span asp-validation-for="ProductPrice" class="text-bg-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CategoryId" class="control-label">Category</label>
            <select asp-for="CategoryId" class="form-select">
                @{
                    <option selected disabled hidden style="display: none; color: lightgrey" value="default">Choose an option...</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.CategoryId">@category.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label asp-for="ProductStock" class="form-label">Stock</label>
            <input asp-for="ProductStock" class="form-control"/>
            <span asp-validation-for="ProductStock" class="text-bg-danger"></span>
        </div>
        <br/>
        <div class="d-flex justify-content-end gap-2 form-group">
            <input type="submit" value="Save" class="btn btn-primary">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

